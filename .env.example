# Carpeta raíz del lakehouse (landing, bronze, silver, gold, _meta y warehouse.duckdb)
LAKEHOUSE_ROOT=data
# Proporción máxima de filas con error antes de rechazar un año en silver
LAKEHOUSE_MAX_ERROR_RATIO=0.05
# auto | latest | sum  -> cómo agregar PIA/PIM (ver docs/adr/0006-semantica-presupuesto.md)
LAKEHOUSE_BUDGET_SEMANTICS=auto
